<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="4.0" client="site" method="upgrade">
    <name>MOD_MOODLE_COURSES</name>
    <author>Joomla Moodle Integrator</author>
    <creationDate>2026</creationDate>
    <copyright>Open Source</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>admin@example.com</authorEmail>
    <authorUrl>https://example.com</authorUrl>
    <version>1.0.0</version>
    <description>MOD_MOODLE_COURSES_XML_DESCRIPTION</description>
    <namespace path="src">MyCompany\Module\MoodleCourses</namespace>
    
    <files>
        <folder module="mod_moodle_courses">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>
    
    <languages folder="language">
        <language tag="en-GB">en-GB/mod_moodle_courses.ini</language>
        <language tag="en-GB">en-GB/mod_moodle_courses.sys.ini</language>
        <language tag="pt-BR">pt-BR/mod_moodle_courses.ini</language>
        <language tag="pt-BR">pt-BR/mod_moodle_courses.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="moodle_url"
                    type="url"
                    label="MOD_MOODLE_COURSES_FIELD_URL_LABEL"
                    description="MOD_MOODLE_COURSES_FIELD_URL_DESC"
                    required="true"
                    filter="url"
                />
                <field
                    name="moodle_token"
                    type="password"
                    label="MOD_MOODLE_COURSES_FIELD_TOKEN_LABEL"
                    description="MOD_MOODLE_COURSES_FIELD_TOKEN_DESC"
                    required="true"
                />
                <field
                    name="course_limit"
                    type="number"
                    label="MOD_MOODLE_COURSES_FIELD_LIMIT_LABEL"
                    description="MOD_MOODLE_COURSES_FIELD_LIMIT_DESC"
                    default="6"
                    min="1"
                    max="50"
                />
                <field
                    name="show_summary"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_MOODLE_COURSES_FIELD_SHOW_SUMMARY_LABEL"
                    description="MOD_MOODLE_COURSES_FIELD_SHOW_SUMMARY_DESC"
                    default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                />
                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    default="1">
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>
                <field
                    name="cache_time"
                    type="number"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    default="900"
                />
            </fieldset>
        </fields>
    </config>
</extension>
